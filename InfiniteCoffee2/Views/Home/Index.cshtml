@{
    ViewBag.Title = "Infinite Coffee";
}

<section class="hero-home">
    <div class="hero-copy">
        <p class="eyebrow">cafe, encontros e possibilidades</p>
        <h1>INFINITE<br /><span>COFFEE</span></h1>
        <p class="hero-intro">Um jeito mais leve de cuidar da sua cafeteria, do primeiro pedido ao ultimo gole.</p>
        <div class="hero-actions">
            <a href="/Atendimento" class="btn btn-primary btn-lg">Novo Atendimento</a>
            <a href="/Produto" class="btn btn-outline-secondary btn-lg">Ver cardapio</a>
        </div>
    </div>
    <div class="coffee-illustration" aria-label="Ilustracao de duas pessoas em xicaras de cafe">
        <div class="steam steam-one"></div>
        <div class="steam steam-two"></div>
        <div class="steam steam-three"></div>
        <div class="cup cup-left"><span class="cup-coffee"></span></div>
        <div class="cup cup-right"><span class="cup-coffee"></span></div>
        <div class="person person-reader"><span class="head"></span><span class="body"></span><span class="book"></span></div>
        <div class="person person-left"><span class="head"></span><span class="body"></span></div>
        <div class="person person-right"><span class="head"></span><span class="body"></span></div>
    </div>
</section>

<section class="quick-menu">
    <div class="section-heading">
        <p class="eyebrow">painel da casa</p>
        <h2>O que voce quer fazer?</h2>
    </div>
    <div class="quick-grid">
        <a href="/Cliente" class="quick-card"><span class="quick-icon">◎</span><span>Clientes</span><small>Cadastros e contatos</small></a>
        <a href="/Produto" class="quick-card"><span class="quick-icon">◒</span><span>Cardapio</span><small>Produtos e precos</small></a>
        <a href="/Mesa" class="quick-card"><span class="quick-icon">▱</span><span>Mesas</span><small>Disponibilidade da casa</small></a>
        <a href="/Pedido" class="quick-card"><span class="quick-icon">☷</span><span>Pedidos Abertos</span><small>Acompanhe os atendimentos</small></a>
        <a href="/Relatorio" class="quick-card"><span class="quick-icon">◌</span><span>Relatorios</span><small>Veja o movimento</small></a>
        <a href="/Estoque" class="quick-card"><span class="quick-icon">▣</span><span>Estoque</span><small>Entradas, saídas e alertas</small></a>
    </div>
</section>
