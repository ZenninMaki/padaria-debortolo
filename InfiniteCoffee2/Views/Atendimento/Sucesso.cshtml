@{ ViewBag.Title = "Atendimento Finalizado"; }

<div class="text-center mt-5">
    <h1>✅</h1>
    <h2>Atendimento Finalizado!</h2>
    @if (TempData["Mensagem"] != null)
    {
        <p class="text-success fs-5">@TempData["Mensagem"]</p>
    }
    <a href="/Atendimento" class="btn btn-primary mt-3">Novo Atendimento</a>
    <a href="/" class="btn btn-secondary mt-3">Voltar ao Início</a>
</div>
