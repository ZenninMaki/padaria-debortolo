@{ ViewBag.Title = "Pagamento"; }

<h2>Pagamento</h2>
<p class="text-muted">Pedido #@ViewBag.PedidoId</p>

<div class="card p-4" style="max-width: 400px;">
    <h4>Total: <strong class="text-success">R$ @ViewBag.Total</strong></h4>

    <form method="post" action="/Atendimento/Finalizar">
        <div class="mb-3 mt-3">
            <label class="form-label">Forma de Pagamento</label>
            <div class="d-flex gap-2">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="forma" value="Dinheiro" id="dinheiro" checked />
                    <label class="form-check-label" for="dinheiro">Dinheiro</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="forma" value="Cartão" id="cartao" />
                    <label class="form-check-label" for="cartao">Cartão</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="forma" value="Pix" id="pix" />
                    <label class="form-check-label" for="pix">Pix</label>
                </div>
            </div>
        </div>
        <button type="submit" class="btn btn-success w-100">Finalizar Atendimento</button>
    </form>
</div>
