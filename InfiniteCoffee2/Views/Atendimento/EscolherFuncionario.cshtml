@{ ViewBag.Title = "Funcionário Responsável"; }

<h2>Novo Atendimento</h2>
<p class="text-muted">Etapa 3 de 4 — Funcionário Responsável</p>

<form method="post" action="/Atendimento/CriarPedido">
    <table class="table table-striped">
        <thead><tr><th>ID</th><th>Nome</th><th>Cargo</th><th></th></tr></thead>
        <tbody>
            @foreach (var f in (List<Dictionary<string, object>>)ViewBag.Funcionarios)
            {
                <tr>
                    <td>@f["id_funcionario"]</td>
                    <td>@f["nome_funcionario"]</td>
                    <td>@f["cargo"]</td>
                    <td>
                        <form method="post" action="/Atendimento/CriarPedido">
                            <input type="hidden" name="funcionarioId" value="@f["id_funcionario"]" />
                            <button type="submit" class="btn btn-sm btn-success">Selecionar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</form>
