@model List<Dictionary<string, object>>
@{ ViewBag.Title = "Produtos"; }

<h2>Cardápio</h2>

@if (TempData["Mensagem"] != null)
{
    <div class="alert alert-success">@TempData["Mensagem"]</div>
}

<a href="/Produto/Cadastrar" class="btn btn-primary mb-3">+ Novo Produto</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Preço</th>
            <th>Tipo</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p["id_produto"]</td>
                <td>@p["nome_produto"]</td>
                <td>R$ @p["preco"]</td>
                <td>@p["tipo"]</td>
                <td>
                    <a href="/Produto/Editar/@p["id_produto"]" class="btn btn-sm btn-warning">Editar</a>
                    <a href="/Produto/Excluir/@p["id_produto"]" class="btn btn-sm btn-danger"
                       onclick="return confirm('Confirmar exclusão?')">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
